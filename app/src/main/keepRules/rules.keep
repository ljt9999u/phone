# ---- kotlinx.serialization ----
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.**
-keepclassmembers class com.example.album.** {
    *** Companion;
}
-keepclasseswithmembers class com.example.album.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class com.example.album.**$$serializer { *; }
-keepclassmembers class com.example.album.** {
    public protected *;
    private *;
}
# 所有 @Serializable 模型类完整保留
-keep @kotlinx.serialization.Serializable class com.example.album.** { *; }

# ---- Retrofit / OkHttp ----
-keepattributes Signature, Exceptions
-keep,allowobfuscation interface retrofit2.** { *; }
-keep class retrofit2.** { *; }
-dontwarn retrofit2.**
-keep class okhttp3.** { *; }
-dontwarn okhttp3.**
-dontwarn okio.**
-keepclasseswithmembers class * {
    @retrofit2.http.* <methods>;
}

# ---- Coil ----
-dontwarn coil.**

# ---- 数据模型不被混淆（序列化字段名依赖） ----
-keep class com.example.album.data.model.** { *; }
